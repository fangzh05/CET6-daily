{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cet6-daily", "main": "worker/index.ts", "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"], "workers_dev": false, "preview_urls": false,
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "env": {
    "development": {
      "name": "cet6-daily-development", "workers_dev": false, "preview_urls": false,
      "vars": { "APP_ENV": "development", "LOCAL_DEV_AUTH": "true", "DEV_EMAIL": "local@cet6.invalid" }
    },
    "production": {
      "name": "cet6-daily", "workers_dev": false, "preview_urls": false,
      "vars": { "APP_ENV": "production", "LOCAL_DEV_AUTH": "false" },
      // Custom domains. The zone must already exist in this account. Every host
      // must also appear in the ALLOWED_HOSTS secret; the worker rejects any
      // request whose Host is not listed there.
      //
      // cet6-test.zehaoo.top MUST stay bound while the Cloudflare Access
      // application still lists it: Access posts its post-login handshake to
      // /cdn-cgi/access/authorized on the app's primary destination, and if that
      // host has no route the login fails with a connection error. Retire the
      // host from the Access application FIRST, then remove it here.
      "routes": [
        { "pattern": "cet6-test.zehaoo.top", "custom_domain": true },
        { "pattern": "cet6.zehaoo.top", "custom_domain": true }
      ]
      // Account-specific values are secrets, never committed (this repository is
      // public). Set them once per environment:
      //   npx wrangler secret put DATABASE_URL      --env production
      //   npx wrangler secret put ACCESS_ISSUER     --env production
      //   npx wrangler secret put ACCESS_AUDIENCE   --env production
      //   npx wrangler secret put ADMIN_EMAILS      --env production
      //   npx wrangler secret put ALLOWED_HOSTS     --env production
      // Optional, only for data-preserving identity migration (see docs/deployment.md):
      //   npx wrangler secret put IDENTITY_ALIASES  --env production
      // ALLOWED_EMAILS is the legacy name of ADMIN_EMAILS and is still honoured
      // if ADMIN_EMAILS is absent. Regular accounts are invite-only: the
      // Cloudflare Access policy may allow any verified email, while the Worker
      // only serves data to accounts created by redeeming an invite.
    }
  }
}
